# Local development: copy to `.env` in the repository root (never commit `.env`).
# `pnpm dev:api` and `pnpm --filter @gamecollabs/api cli ...` read it automatically;
# values exported in the shell take precedence.

MONGODB_URI=mongodb://127.0.0.1:27017/gamecollabs?replicaSet=rs0&directConnection=true
# Any long random string; the Next.js server sends it as a Bearer token.
SERVICE_TOKENS=change-me-dev-service-token
# At least 32 characters, e.g. `openssl rand -hex 32`. Generate once and keep it.
ADMIN_JWT_SECRET=change-me-at-least-32-characters-long-secret
LOG_LEVEL=info
# Source URL checks reach the internet; keep them on unless you are offline.
INGEST_VERIFY_SOURCES=true
