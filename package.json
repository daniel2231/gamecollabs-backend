{
  "name": "gamecollabs-backend",
  "private": true,
  "description": "Game IP Collab Tracker backend: Express API, MCP ingest server and shared Zod schemas",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev:api": "pnpm --filter @gamecollabs/api dev",
    "dev:mcp": "pnpm --filter @gamecollabs/mcp dev"
  }
}
