# MCP server (deploy/.env.mcp)
PUBLIC_URL=https://mcp.example.com
# Ingest-scoped token: `pnpm --filter @gamecollabs/api cli create-token --name mcp --role ingest`
INTERNAL_API_KEY=gct_...
# Optional: admin-role token for the editing tools on /mcp/admin (Claude connector).
#   docker compose exec api node dist/cli/index.js create-token --name mcp-admin --role admin
# Leave empty to keep the MCP server ingest-only.
ADMIN_API_KEY=
MCP_JWT_SECRET=change-me-at-least-32-characters-long-secret
# GitHub OAuth app, callback URL: https://mcp.example.com/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_LOGIN=daniel2231
