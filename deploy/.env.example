# API (deploy/.env). Every host and secret is an environment variable; the same image runs in the cloud.
LOG_LEVEL=info
# Next.js server → API. Comma-separated to rotate without downtime.
SERVICE_TOKENS=change-me-long-random-string
# Shared with Next.js, which signs short-lived admin JWTs after GitHub login (sub = GitHub login).
ADMIN_JWT_SECRET=change-me-at-least-32-characters-long-secret
ADMIN_JWT_ISSUER=gamecollabs-web
ADMIN_JWT_AUDIENCE=gamecollabs-api
CORS_ORIGINS=https://example.com
TRUST_PROXY=1
READ_ONLY_MODE=false

# Next.js on-demand revalidation (POST { tags: [...] } with Bearer secret)
WEB_REVALIDATE_URL=https://example.com/api/revalidate
WEB_REVALIDATE_SECRET=change-me

# Operator alerts (Slack/Discord webhook)
ALERT_WEBHOOK_URL=

# Cloudflare R2 (S3 API). Switch to Garage/S3 by changing endpoint and keys.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_BASE_URL=https://media.example.com

# Submission form bot check (optional)
TURNSTILE_SECRET=

INGEST_DAILY_LIMIT=100
INGEST_VERIFY_SOURCES=true

# Fallback collector (only when ChatGPT scheduled tasks + MCP are unavailable)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MONTHLY_BUDGET_USD=10
OPENAI_PRICE_INPUT_PER_MTOK=0
OPENAI_PRICE_OUTPUT_PER_MTOK=0

# docker compose variables
CLOUDFLARE_TUNNEL_TOKEN=
